<mujoco model="scene">

    <include file="floating_grippers/rum/model.xml"/>

    <statistic center="0.2 0 0.2" extent="1.0"/>

    <option iterations="10" ls_iterations="10" integrator="implicitfast" cone="elliptic">
        <flag eulerdamp="disable"/>
    </option>


    <custom>
        <numeric data="12" name="max_contact_points"/>
    </custom>


    <visual>
        <headlight diffuse=".8 .8 .8" ambient=".2 .2 .2" specular="1 1 1"/>
        <rgba force="1 0 0 1"/>
        <global azimuth="-40" elevation="-30"/>
        <map force="0.01"/>
        <quality shadowsize="8192"/>
        <scale contactwidth="0.075" contactheight="0.025" forcewidth="0.05" com="0.05" framewidth="0.01"
            framelength="0.2"/>
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.8 0.8 0.8" rgb2="0.8 0.8 0.8"
            markrgb="0.8 0.8 0.8" width="300" height="300"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"/>
        <texture name="table_texture" type="2d" height="1" width="1" file="textures/wood0.png"/>
        <material name="table_material" texture="table_texture" rgba="1.0 1.0 1.0 1.0" texuniform="false"/>
    </asset>


    <worldbody>


        <!-- <geom name="floor" type="box" pos="0 0 0" size="1.75 1.75 0.05" rgba="1.0 1.0 1.0 1"/>
        <geom name="wall_north" type="box" pos="0 1.75 1" size="1.75 0.02 1" rgba="1.0 1.0 1.0 1"/>
        <geom name="wall_east" type="box" pos="1.75 0 1" size="0.02 1.75 1" rgba="1.0 1.0 1.0 1"/>
        <geom name="wall_west" type="box" pos="-1.75 0 1" size="0.02 1.75 1" rgba="1.0 1.0 1.0 1"/>
        <geom name="wall_south" type="box" pos="0 -1.75 1" size="1.75 0.02 1" rgba="1.0 1.0 1.0 1"/> -->


        <geom name="target" pos="0 0 10" size="0.01" type="sphere" rgba="0.2 0.7 0.2 1" conaffinity="0" contype="0"/>

        <site name="reference" pos="0 0 .25" rgba="0 0 0 0"/>
        <light pos="0 0 2.0" dir="0 0 -1" directional="true" diffuse="0.4 0.4 0.35" specular="0.1 0.1 0.1"/>


        <body name="object_body" pos="0.0 0.3 0.78">
            <freejoint/>
            <geom type="box" name="object_geom" size="0.02 0.02 0.02" condim="3" friction="1 .03 .003" rgba="0 0 1 1"
                contype="1" conaffinity="2" solref="0.01 1"/>
        </body>

        <body name="table" pos="0 0.3 0">

            <geom name="table_top" material="table_material" type="box" size=".375 .375 .025" pos="0 0 0.735"/>
            <!-- <geom type="box" rgba="0 0 0 1" size="0.025 0.025 0.4" pos="-0.21 0.21 0.33"/>
            <geom type="box" rgba="0 0 0 1" size="0.025 0.025 0.4" pos="-0.21 -0.21 0.33"/>
            <geom type="box" rgba="0 0 0 1" size="0.025 0.025 0.4" pos="0.21 0.21 0.33"/>
            <geom type="box" rgba="0 0 0 1" size="0.025 0.025 0.4" pos="0.21 -0.21 0.33"/> -->

        </body>
    </worldbody>

    <keyframe>
        <key name="home" qpos="0 -0.35 0.85 1 0 0 0 0 0 0 0.3 0.78 1 0 0 0" ctrl="0"/>
    </keyframe>

</mujoco>