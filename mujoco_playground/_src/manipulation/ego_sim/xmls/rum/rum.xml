<mujoco model="rum">
  <compiler angle="radian" meshdir="" texturedir=""/>


  <asset>
    <mesh name="gripper_body" file="meshes/gripper_body.stl" scale="0.001 0.001 0.001"/>
    <mesh name="finger" file="meshes/finger.stl" scale="0.001 0.001 0.001"/>
    <mesh name="foam_insert" file="meshes/foam_insert.stl" scale="0.0011 0.0011 0.001"/>
    <mesh name="foam_collision" file="meshes/foam_insert.stl" scale="0.0011 0.00125 0.001"/>
    <material name="white" rgba="1 1 1 1"/>
    <material name="gray" rgba="0.15 0.15 0.15 1"/>
    <material name="light_gray" rgba="0.6 0.6 0.6 1"/>
    <material name="light_blue" rgba="0.35 0.757 0.95 1"/>
    <material name="black" rgba="0.05 0.05 0.05 1"/>
  </asset>

  <default>
    <default class="dobbe">
      <joint frictionloss="0.1" armature="0.1"/>
      <position kp="100"/>
    </default>

    <default class="translation">
      <joint type="slide" armature="1e-3" damping="10" stiffness="1e-2" actuatorfrcrange="-100 100"
        actuatorgravcomp="true"/>
      <position kp="500" dampratio="1" ctrlrange="-1.2 1.2"/>
    </default>

    <default class="rotation">
      <joint type="hinge" armature="1e-3" damping="40" stiffness="1e-2" actuatorfrcrange="-100 100"
        actuatorgravcomp="true"/>
      <position kp="10" dampratio="1" ctrlrange="-30.1415 30.1415"/>
    </default>

    <default class="finger_hinge">
      <joint type="hinge" stiffness="0.1" damping="0.01" armature="0.01" range="-1.57 0" frictionloss="0.2"
        springref="0"/>
      <position kp="100" dampratio="1" ctrlrange="-1.57 0"/>
    </default>

    <default class="finger_actuator">
      <position ctrlrange="-0.8 0" kp="300" dampratio="20"/>
    </default>

    <default class="friction">
      <geom condim="6" friction="1.5 0.005 0.0001" priority="1" solref="0.01 1" solimp="0.99 0.995 0.01" conaffinity="1"
        contype="1" rgba="0 0 0 0"/>
    </default>

    <default class="visual">
      <geom type="mesh" contype="0" conaffinity="0" density="0" group="0"/>
    </default>

    <default class="collision">
      <geom type="mesh" group="3" friction="0.8 0.05 0.01" density="100"/>
    </default>
  </default>


  <worldbody>

    <body name="target_ee_pose" mocap="true" pos="0 -0.55 0.85" euler="0 0 0">
      <geom name="target_ee_pose" type="box" rgba="0 1 0 1.0" size="0.01 0.01 0.01" conaffinity="0" contype="0"
        mass="10.0"/>
      <site name="target_ee_pose" pos="0 0 0.0" size="0.01" rgba="0 1 0 1"/>
    </body>


    <camera name="top_camera" mode="fixed" fovy="57" pos="0.0 -1.3 1.4" euler="1.0 0 0" resolution="960 720"/>

    <camera name="back_camera" mode="fixed" fovy="60" pos="0.5 0.7 1.2" euler="-1.0 0.5 2.8" resolution="960 720"/>

    <body name="base" pos="0 -0.55 0.85" euler="0 0 0" gravcomp="1">

      <joint type="free" name="rum_free_joint" armature="0.01" damping="1"/>

      <geom name="gripper_body_visual" mesh="gripper_body" class="visual" material="white"/>
      <geom name="gripper_body_collision_0" type="box" size="0.04 0.05 0.015" pos="0 0 0.015" euler="0 0 0"
        rgba="1 0 0 0"/>
      <geom name="gripper_body_collision_1" type="box" size="0.024 0.024 0.015" pos="0 -0.02 0.045" euler="0 0 0"
        rgba="1 0 0 0"/>

      <body name="iphone_body" pos="0 0 0" gravcomp="1">
        <!-- <geom name="iphone_visual" mesh="iphone" class="visual" material="gray"/> -->

        <body name="camera_body" pos="0.0 -0.036 0.1" euler="1.309 0 0.0" gravcomp="1">
          <geom type="box" size="0.01 0.01 0.01" rgba="0.1 0.5 0.1 0" contype="0" conaffinity="0"/>
          <camera name="egocentric" mode="fixed" fovy="53.1" resolution="960 720"/>
        </body>
      </body>

      <body name="tcp" pos="0 0.1 0" euler="0 0 0">
        <site name="grasping_center" pos="0 0 0" size="0.01" rgba="1 0 0 1"/>
      </body>

      <body name="fingers" pos="0 0 0.0" gravcomp="1">
        <body name="left_finger" pos="0 0 -0.0042" gravcomp="1">
          <joint name="finger_left_joint" axis="0 0 1" class="finger_hinge" pos="-0.0242 0.04224 0.0"/>
          <geom name="left_finger_visual" mesh="finger" class="visual" material="light_blue"/>
          <body name="left_collisions">
            <geom name="left_finger_collision_0" type="box" size="0.002 0.042 0.0131" pos="-0.056 0.095 0.0179"
              euler="0 0 0.61" class="friction" mass="0.1"/>
            <geom name="left_finger_collision_1" type="box" size="0.002 0.042 0.0131" pos="-0.057 0.09 0.0179"
              euler="0 0 0.61" class="friction" mass="0.1"/>
            <geom name="left_finger_collision_2" type="box" size="0.002 0.042 0.0131" pos="-0.058 0.085 0.0179"
              euler="0 0 0.61" class="friction" mass="0.1"/>
            <geom name="left_finger_collision_3" type="box" size="0.002 0.042 0.0131" pos="-0.059 0.08 0.0179"
              euler="0 0 0.61" class="friction" mass="0.1"/>
            <geom name="left_finger_collision_4" type="box" size="0.002 0.042 0.0131" pos="-0.06 0.075 0.0179"
              euler="0 0 0.61" class="friction" mass="0.1"/>
          </body>
          <geom name="left_finger_foam_visual" mesh="foam_insert" class="visual" material="black"
            pos="-0.00468 0.101585 0.00197" euler="0 0 3.75" mass="0.1"/>
        </body>

        <body name="right_finger" pos="0 0 0.0317" euler="0 3.1415 0" gravcomp="1">
          <joint name="finger_right_joint" axis="0 0 1" class="finger_hinge" pos="-0.0242 0.04224 0.0"/>
          <geom name="right_finger_visual" mesh="finger" class="visual" material="light_blue"/>
          <geom name="right_finger_foam" mesh="foam_insert" class="visual" material="black" mass="0.1"
            pos="-0.00468 0.101585 0.00197" euler="0 0 3.75"/>
          <body name="right_collisions">
            <geom name="right_finger_collision_0" type="box" size="0.002 0.042 0.0131" pos="-0.056 0.095 0.0179"
              euler="0 0 0.61" class="friction" mass="0.1"/>
            <geom name="right_finger_collision_1" type="box" size="0.002 0.042 0.0131" pos="-0.057 0.09 0.0179"
              euler="0 0 0.61" class="friction" mass="0.1"/>
            <geom name="right_finger_collision_2" type="box" size="0.002 0.042 0.0131" class="friction"
              pos="-0.058 0.085 0.0179" euler="0 0 0.61" mass="0.1"/>
            <geom name="right_finger_collision_3" type="box" size="0.002 0.042 0.0131" class="friction"
              pos="-0.059 0.08 0.0179" euler="0 0 0.61" mass="0.1"/>
            <geom name="right_finger_collision_4" type="box" size="0.002 0.042 0.0131" class="friction"
              pos="-0.06 0.075 0.0179" euler="0 0 0.61" mass="0.1 "/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <tendon>
    <fixed name="split">
      <joint joint="finger_right_joint" coef="0.49"/>
      <joint joint="finger_left_joint" coef="0.49"/>
    </fixed>
  </tendon>

  <actuator>
    <general biastype="affine" name="fingers_actuator" tendon="split" forcerange="-15 15" ctrlrange="-255 0"
      gainprm="0.3137255 0 0" biasprm="0 -100 -10"/>

  </actuator>
  <equality>
    <weld site1="target_ee_pose" site2="grasping_center" solref="0.02 1"
      solimp="0.98999999999999999 0.98999999999999999 0.001"/>
    <joint joint1="finger_right_joint" joint2="finger_left_joint" polycoef="0 1 0 0 0" solimp="0.95 0.99 0.001"
      solref="0.005 1"/>
  </equality>

</mujoco>